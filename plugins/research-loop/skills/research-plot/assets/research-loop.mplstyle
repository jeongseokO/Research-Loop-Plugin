# Research Loop plotting defaults. Hex colors omit # for mplstyle parsing.
figure.facecolor: white
axes.facecolor: white
savefig.facecolor: white
savefig.edgecolor: white
savefig.transparent: False
figure.dpi: 120
savefig.dpi: 300
font.family: sans-serif
font.size: 12
mathtext.fontset: dejavusans
mathtext.fallback: stix
text.color: 223047
axes.labelcolor: 334155
axes.edgecolor: E7EDF4
axes.titlecolor: 223047
axes.titlesize: 16
axes.titleweight: bold
axes.titlelocation: left
axes.titlepad: 12
axes.labelsize: 12
axes.labelpad: 8
axes.axisbelow: True
axes.spines.top: False
axes.spines.right: False
axes.spines.left: False
axes.spines.bottom: False
axes.grid: False
axes.prop_cycle: cycler('color', ['2563B9', 'C97212', 'B5BFCB', '7652AF'])
xtick.color: 334155
ytick.color: 334155
xtick.major.size: 0
ytick.major.size: 0
xtick.major.pad: 7
ytick.major.pad: 7
grid.color: E7EDF4
grid.linewidth: 0.7
grid.alpha: 1.0
grid.linestyle: -
lines.linewidth: 1.8
lines.markersize: 5
patch.linewidth: 0
legend.frameon: False
legend.fontsize: 9
svg.fonttype: path
pdf.fonttype: 42
ps.fonttype: 42
text.usetex: False
